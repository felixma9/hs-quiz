{
  "name": "hs-quiz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cards": "tsx scripts/build-cards.ts",
    "history": "tsx scripts/build-history.ts",
    "test": "vitest run",
    "deploy": "npm test && npm run build && touch dist/.nojekyll && gh-pages -d dist -t"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "peerjs": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sunwell": "^0.10.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.2"
  },
  "overrides": {
    "sunwell": {
      "linebreak": "1.1.0"
    }
  }
}
